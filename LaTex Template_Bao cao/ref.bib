@article{MAIN_Cai_2000,
 ISSN = {00251909, 15265501},
 URL = {http://www.jstor.org/stable/2661611},
 abstract = {This paper provides a new portfolio selection rule. The objective is to minimize the maximum individual risk and we use an $l_\infty$ function as the risk measure. We provide an explicit analytical solution for the model and are thus able to plot the entire efficient frontier. Our selection rule is very conservative. One of the features of the solution is that it does not explicitly involve the covariance of the asset returns.},
